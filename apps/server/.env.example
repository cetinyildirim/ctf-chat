NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET=please-replace-with-32+-char-random-string
JWT_REFRESH_SECRET=please-replace-with-another-32-char-random-string
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
CORS_ORIGIN=http://localhost:3100
COOKIE_DOMAIN=
COOKIE_SECURE=false
# ALLOW_BEARER_AUTH=false  # optional; defaults off in production, on in dev
SERVER_INVITE_TTL_DAYS=7
LOG_LEVEL=info
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=12
BACKUP_DIR=backups
# Antivirus scan of uploads via clamd (fail-open: scanner outage never blocks uploads)
CLAMAV_ENABLED=false
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
