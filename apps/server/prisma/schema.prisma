// SYDT Prisma schema
// SQLite for dev. Swap provider to "postgresql" (and DATABASE_URL) for prod;
// enums are modeled as strings to keep portability.
// Schema changes: prefer `pnpm db:migrate:dev` (versioned). `db:push` is emergency-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  role         String   @default("TEAM_MEMBER")
  platformRole String? // staff platform role; kept when user joins a competition team
  status       String   @default("OFFLINE")
  avatarUrl    String?
  bio          String?
  lastSeenAt   DateTime?
  isBanned     Boolean  @default(false)
  /// Null while banned = indefinite; the ban lifts automatically once this passes.
  bannedUntil  DateTime?
  banReason    String?
  mutedUntil   DateTime?
  mutedSince   DateTime?
  muteReason   String?
  /// Set by an admin password reset; cleared once the user picks a new password.
  mustChangePassword Boolean @default(false)
  /// Deactivated accounts cannot sign in; history is kept.
  disabledAt     DateTime?
  disabledReason String?
  preferredLocale String @default("tr")
  preferredTheme  String @default("dark")
  notifyDefault   String @default("ALL")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  captainOf    Team?    @relation("TeamCaptain")

  friendshipsAsRequester Friendship[] @relation("FriendshipRequester")
  friendshipsAsAddressee Friendship[] @relation("FriendshipAddressee")
  dmChannels            ChannelDmParticipant[]
  channelNotifyPrefs    UserChannelPreference[]

  messages     Message[]
  reactions    Reaction[]
  refreshTokens RefreshToken[]

  pinnedBy     Pin[]

  openedTickets   Ticket[] @relation("TicketOpenedBy")
  assignedTickets Ticket[] @relation("TicketAssignedTo")
  ticketEvents    TicketEvent[]
  ticketReads     TicketRead[]
  ticketRelationsCreated TicketRelation[] @relation("TicketRelationCreator")
  notifications   Notification[]
  uploadedAttachments Attachment[] @relation("AttachmentUploader")

  openedIncidents   Incident[] @relation("IncidentOpenedBy")
  assignedIncidents Incident[] @relation("IncidentAssignedTo")

  announcements Announcement[]
  solves        Solve[]
  hintUnlocks   HintUnlock[]
  auditLogs     AuditLog[]
  authoredChallenges Challenge[] @relation("ChallengeAuthor")
  surveyResponses SurveyResponse[]
  announcementAcks AnnouncementAck[]
  surveysCreated  Survey[] @relation("SurveyCreator")
  broadcastsAuthored AdminBroadcast[] @relation("BroadcastAuthor")
  reportsMade      UserReport[] @relation("ReportsMade")
  reportsReceived  UserReport[] @relation("ReportsReceived")
  reportsReviewed  UserReport[] @relation("ReportsReviewed")

  serverMembers       ServerMember[]
  serverBansIssued    ServerMember[] @relation("ServerMemberBannedBy")
  serverTeamMembers   ServerTeamMember[]
  memberServerRoles   MemberServerRole[]
  serverInvitesCreated ServerInvite[] @relation("ServerInviteCreator")
  serverNotifyPrefs   UserServerPreference[]
  platformPagesAuthored PlatformPage[] @relation("PlatformPageAuthor")

  @@index([role])
  @@index([mutedUntil])
  @@index([teamId])
}

model UserReport {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId   String
  reported     User      @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  contextType  String?
  contextId    String?
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([reportedId])
  @@index([reporterId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  serverId  String?
  slug      String
  name      String
  tagline   String?
  color     String   @default("#22d3ee")
  logoUrl   String?
  inviteCode String  @default(cuid())
  ctfdTeamId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server    ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  captainId String?  @unique
  captain   User?    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)

  members   User[]   @relation("TeamMembers")
  serverMembers ServerTeamMember[]
  solves    Solve[]
  tickets   Ticket[]
  privateChannels Channel[]
  categories Category[]
  bloodChallenges Challenge[] @relation("FirstBloodTeam")
  hintUnlocks HintUnlock[]

  @@unique([serverId, slug], name: "team_server_slug")
  @@unique([serverId, inviteCode], name: "team_server_invite")
  @@index([serverId])
}

model ServerTeamMember {
  userId   String
  serverId String
  teamId   String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
  @@index([teamId])
  @@index([serverId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model ChannelDmParticipant {
  channelId  String
  userId     String
  /// Null = never opened; peer messages after this count as unread.
  lastReadAt DateTime?
  channel    Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model UserChannelPreference {
  userId    String
  channelId String
  notifyMode String @default("DEFAULT")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model ChatServer {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  position    Int      @default(0)
  themePrimary String?
  themeAccent  String?
  emailNotifyEnabled Boolean @default(false)
  requirePasswordChangeOnJoin Boolean @default(false)
  /// New registrations (and admin-created users) also join this server.
  autoJoinNewUsers   Boolean @default(false)
  emailReplyTo       String?
  ctfdBaseUrl        String?
  ctfdAccessToken    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  Category[]
  channels    Channel[]
  members     ServerMember[]
  teams       Team[]
  teamMembers ServerTeamMember[]
  invites     ServerInvite[]
  notifyPrefs UserServerPreference[]
  announcements Announcement[]
  webhooks    ServerWebhook[]
  roles             ServerRole[]
  memberServerRoles MemberServerRole[]
  tickets           Ticket[]
  ticketCategories  TicketCategory[]
  ticketTags        Tag[]
  competition       CompetitionSettings?
  notifications     Notification[]
  incidents         Incident[]

  @@index([position])
}

model ServerRole {
  id              String   @id @default(cuid())
  serverId        String
  name            String
  color           String   @default("#a78bfa")
  position        Int      @default(0)
  hoist           Boolean  @default(false)
  permissionsJson String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  server      ChatServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  assignments MemberServerRole[]

  @@unique([serverId, name])
  @@index([serverId, position])
}

model MemberServerRole {
  userId   String
  serverId String
  roleId   String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  role   ServerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([serverId, userId])
  @@index([roleId])
}

model ServerWebhook {
  id         String   @id @default(cuid())
  serverId   String
  label      String
  url        String
  secret     String?
  eventsJson String   @default("[\"announcement.publish\"]")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  server ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

model ServerMember {
  userId     String
  serverId   String
  nickname   String?
  avatarUrl  String?
  joinedAt   DateTime  @default(now())
  mustChangePassword Boolean @default(false)
  bannedAt   DateTime?
  bannedById String?
  banReason  String?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  bannedBy User?      @relation("ServerMemberBannedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@id([userId, serverId])
  @@index([serverId])
  @@index([serverId, bannedAt])
}

model ServerInvite {
  id        String    @id @default(cuid())
  serverId  String
  code      String    @unique
  creatorId String
  channelId String?
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  server  ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User       @relation("ServerInviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  channel Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([serverId])
  @@index([creatorId])
}

model UserServerPreference {
  userId     String
  serverId   String
  notifyMode String @default("DEFAULT")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
}

model Category {
  id       String   @id @default(cuid())
  name     String
  position Int      @default(0)
  staffOnly Boolean @default(false)
  logoUrl  String?
  serverId String?
  server   ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// When set, this category is the private workspace for that team.
  teamId   String?
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@unique([serverId, teamId], name: "category_server_team")
  @@index([position])
  @@index([serverId, position])
  @@index([teamId])
}

model Channel {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  topic       String?
  type        String   @default("GLOBAL_CHAT")
  iconKey     String?
  position    Int      @default(0)
  isPrivate   Boolean  @default(false)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  serverId    String?
  server      ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  challengeId String?  @unique
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  logoUrl     String?

  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  messages    Message[]
  pins        Pin[]
  tickets     Ticket[]
  incidents   Incident[]

  dmParticipants    ChannelDmParticipant[]
  notifyPreferences UserChannelPreference[]
  serverInvites     ServerInvite[]
  announcements   Announcement[]

  @@index([categoryId, position])
  @@index([type])
  @@index([serverId, position])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mentionsJson String @default("[]")
  replyToId String?
  replyTo   Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  reactions   Reaction[]
  attachments Attachment[]
  pin         Pin?

  @@index([channelId, createdAt])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Ticket attachments hang off the ticket event that introduced them.
  ticketEventId String?
  ticketEvent   TicketEvent? @relation(fields: [ticketEventId], references: [id], onDelete: Cascade)
  uploadedById  String?
  uploadedBy    User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  name      String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime @default(now())

  @@index([ticketEventId])
  @@index([messageId])
}

model Pin {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId   String   @unique
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById  String
  pinnedBy    User     @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  pinnedAt    DateTime @default(now())
}

model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  difficulty  String
  points      Int      @default(100)
  tagsJson    String   @default("[]")
  isReleased  Boolean  @default(true)
  flag        String
  authorId    String?
  author      User?    @relation("ChallengeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  firstBloodTeamId String?
  firstBloodTeam   Team?  @relation("FirstBloodTeam", fields: [firstBloodTeamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  discussionChannel Channel?
  solves   Solve[]
  hints    Hint[]
  tickets  Ticket[]

  @@index([category])
  @@index([difficulty])
}

model Hint {
  id          String   @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  text        String
  cost        Int      @default(0)

  unlocks     HintUnlock[]

  @@unique([challengeId, order])
}

model HintUnlock {
  id        String   @id @default(cuid())
  hintId    String
  hint      Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([hintId, teamId])
}

model Solve {
  id          String   @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstBlood  Boolean  @default(false)
  solvedAt    DateTime @default(now())

  @@unique([challengeId, teamId])
  @@index([teamId])
  @@index([solvedAt])
}

model Ticket {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  body        String
  status      String   @default("OPEN")

  // Competition scope: every ticket belongs to exactly one ChatServer (competition).
  serverId    String
  server      ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// Per-competition running number rendered as the ticket code.
  seq         Int
  priority    String   @default("MEDIUM")
  /// Numeric mirror of `priority` (LOW=0 .. CRITICAL=3) so the DB can sort by urgency.
  priorityRank Int     @default(1)

  categoryId  String?
  category    TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  openedById  String
  openedBy    User     @relation("TicketOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  challengeId String?
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  /// Response-time metrics (CTF operations, never fed back into scoring).
  firstResponseAt       DateTime?
  lastCompetitorReplyAt DateTime?
  lastOrganizerReplyAt  DateTime?
  reopenCount           Int      @default(0)

  events      TicketEvent[]
  tags        TicketTag[]
  relationsFrom TicketRelation[] @relation("TicketRelationFrom")
  relationsTo   TicketRelation[] @relation("TicketRelationTo")
  reads       TicketRead[]

  @@unique([serverId, seq], name: "ticket_server_seq")
  @@index([status])
  @@index([teamId])
  @@index([serverId, status, updatedAt])
  @@index([serverId, teamId, updatedAt])
  @@index([serverId, priorityRank, updatedAt])
  @@index([serverId, challengeId])
  @@index([serverId, assignedToId])
  @@index([serverId, categoryId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([ticketId, createdAt])
}

/// Admin-managed ticket categories (doubles as the ticket type).
model TicketCategory {
  id       String  @id @default(cuid())
  serverId String
  server   ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  key      String
  name     String
  position Int     @default(0)
  isActive Boolean @default(true)
  /// Forces the reporter to pick a challenge (e.g. challenge issues).
  requiresChallenge Boolean @default(false)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@unique([serverId, key], name: "ticket_category_server_key")
  @@index([serverId, position])
}

model Tag {
  id       String @id @default(cuid())
  serverId String
  server   ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  color    String @default("#a78bfa")
  createdAt DateTime @default(now())

  tickets TicketTag[]

  @@unique([serverId, name], name: "tag_server_name")
  @@index([serverId])
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
}

model TicketRelation {
  id               String @id @default(cuid())
  ticketId         String
  relatedTicketId  String
  /// RELATED | DUPLICATE | PARENT | CHILD
  kind             String
  createdById      String?
  createdAt        DateTime @default(now())

  ticket        Ticket @relation("TicketRelationFrom", fields: [ticketId], references: [id], onDelete: Cascade)
  relatedTicket Ticket @relation("TicketRelationTo", fields: [relatedTicketId], references: [id], onDelete: Cascade)
  createdBy     User?  @relation("TicketRelationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([ticketId, relatedTicketId, kind], name: "ticket_relation_unique")
  @@index([relatedTicketId])
}

/// Per-user read cursor powering ticket unread counts.
model TicketRead {
  ticketId   String
  userId     String
  lastReadAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

/// Durable notification inbox (the client store is ephemeral by design).
model Notification {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String?
  server   ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind     String
  title    String
  body     String   @default("")
  href     String?
  refType  String?
  refId    String?
  metaJson String   @default("{}")
  readAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([refType, refId])
}

/// Competition lifecycle settings for a ChatServer.
model CompetitionSettings {
  serverId  String   @id
  server    ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  startsAt  DateTime?
  endsAt    DateTime?
  timezone  String   @default("Europe/Istanbul")
  /// Ticket code prefix, e.g. `LS26` -> LS26-000001. Globally unique.
  ticketPrefix String @unique
  /// UPCOMING | LIVE | PAUSED | FINISHED
  status    String   @default("UPCOMING")
  /// OPEN | ORGANIZER_ONLY | CLOSED - who may open tickets right now.
  ticketPolicy String @default("OPEN")
  archivedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   @default("MEDIUM")
  status      String   @default("OPEN")

  openedById  String
  openedBy    User     @relation("IncidentOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Competition scope. Prefer this over platform-wide staff fanout.
  serverId    String?
  server      ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([serverId, createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  severity    String   @default("INFO")
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  serverId    String?
  server      ChatServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  scheduledFor DateTime?
  publishedAt DateTime?
  /// Optional expiry; expired announcements stop being served to clients.
  expiresAt   DateTime?
  /// Set when the announcement was generated from a ticket (spec: ticket -> announcement).
  sourceTicketId String?
  /// Recipients cannot use the platform until they acknowledge it.
  requireAck  Boolean  @default(false)
  createdAt   DateTime @default(now())

  acks AnnouncementAck[]

  @@index([createdAt])
  @@index([serverId, publishedAt])
  @@index([scheduledFor])
  @@index([expiresAt])
}

model AnnouncementAck {
  announcementId String
  userId         String
  ackedAt        DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model AppConfig {
  id                          String   @id @default("default")
  uploadMaxMb                 Int      @default(100)
  platformTitle               String   @default("SYDT")
  platformTagline             String   @default("CTF Operations Console")
  workspaceLabel              String   @default("Komuta")
  workspaceTitle              String   @default("SYDT Chat")
  /// Competition new open-registrations join when they have no team invite.
  defaultRegistrationServerId String?
  updatedAt                   DateTime @updatedAt
}

/// Scheduled backup settings (single row) plus the outcome of the last run.
model BackupConfig {
  id             String    @id @default("default")
  enabled        Boolean   @default(false)
  /// EVERY_6H | EVERY_12H | DAILY | WEEKLY
  frequency      String    @default("DAILY")
  /// Server local time, 0-23.
  hour           Int       @default(3)
  /// 0 = Sunday … 6 = Saturday (WEEKLY only).
  weekday        Int       @default(0)
  /// Automatic backups kept; older ones are pruned. Manual backups are never pruned.
  retention      Int       @default(7)
  includeUploads Boolean   @default(true)
  lastAutoRunAt  DateTime?
  lastRunAt      DateTime?
  lastStatus     String?
  lastError      String?
  lastDurationMs Int?
  lastSizeBytes  BigInt?
  updatedAt      DateTime  @updatedAt
}

model AdminBroadcast {
  id              String   @id @default(cuid())
  kind            String
  title           String
  body            String
  recipientCount  Int      @default(0)
  createdById     String?
  createdBy       User?    @relation("BroadcastAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metaJson  String   @default("{}")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([target])
}

model Survey {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  requireBeforeContinue Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdById           String?
  createdBy             User?    @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]
}

model SurveyQuestion {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  type     String @default("SINGLE")
  position Int    @default(0)
  required Boolean @default(true)

  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId, position])
}

model SurveyOption {
  id         String @id @default(cuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  position   Int    @default(0)

  answers SurveyAnswer[]

  @@index([questionId, position])
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  answers SurveyAnswer[]

  @@unique([surveyId, userId])
  @@index([surveyId])
}

model SurveyAnswer {
  id         String  @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String?
  option     SurveyOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  textValue  String?

  @@index([responseId])
  @@index([questionId])
}

model PlatformPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String?
  author    User?    @relation("PlatformPageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published])
}
