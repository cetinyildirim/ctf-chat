# Used by Next.js *server* rewrites (dev / when nginx does not proxy /api).
# Do NOT rely on this for the browser Socket.IO URL — the client always uses
# window.location.origin so production behind nginx keeps live events working.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Must match apps/server JWT_ACCESS_SECRET for Edge middleware JWT verification
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
